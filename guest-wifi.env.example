# Copy to ~/.config/guest-wifi.env and protect it with chmod 600.
# User with the "FRITZ!Box Settings" permission (System > FRITZ!Box Users).
FRITZ_USER=username
FRITZ_PASSWORD=password
# Optional, default is 192.168.178.1
#FRITZ_ADDRESS=192.168.178.1
# Optional: SSID of the guest Wi-Fi. If set, the script aborts when the network
# behind --index has another name, so the main Wi-Fi is never changed by mistake.
#FRITZ_GUEST_SSID=FRITZ!Box Gastzugang
# Optional: e-paper display (firmware/). Without DISPLAY_URL nothing is sent.
# DISPLAY_TOKEN must match DISPLAY_TOKEN in firmware/include/secrets.h.
#DISPLAY_URL=http://guest-display.fritz.box
#DISPLAY_TOKEN=...
