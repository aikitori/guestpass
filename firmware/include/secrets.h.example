// Copy to secrets.h (ignored by git) and fill in the values.
#pragma once

// Home Wi-Fi the display connects to (not the guest Wi-Fi)
#define WIFI_SSID "MyHomeWiFi"
#define WIFI_PASSWORD "..."

// MQTT broker. Leave MQTT_USER empty ("") for a broker without login.
#define MQTT_HOST "broker.fritz.box"
#define MQTT_PORT 1883
#define MQTT_USER "guest-display"
#define MQTT_PASSWORD "..."
// MQTT_TOPIC must match MQTT_TOPIC in ~/.config/guest-wifi.env
#define MQTT_TOPIC "guestpass/wifi"
#define MQTT_STATUS_TOPIC "guestpass/display/status"

// Host name in the home network, also the MQTT client ID
#define HOSTNAME "guest-display"
